# Anthropic API key used for the discovery run (LLM-driven computer use).
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the discovery agent loop. Read at runtime, never hardcoded.
DISCOVERY_MODEL=claude-sonnet-5

# Fallback model to retry with if the discovery agent gets stuck.
DISCOVERY_FALLBACK_MODEL=claude-opus-5

# Port the fake legacy credit-union app listens on.
FAKE_APP_PORT=5055

# Secret key for signing the fake app's session cookie (dev-only value; not a
# real secret, just needs to be present for Starlette's SessionMiddleware).
FAKE_APP_SESSION_SECRET=dev-only-change-me
